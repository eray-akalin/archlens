{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv run archlens facts *)",
      "Bash(uv run archlens schema *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv run archlens assess *)",
      "Bash(uv run archlens eval *)",
      "Bash(uv run pytest -m live *)",
      "Bash(azd *)",
      "Bash(az *)",
      "Bash(gh *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep -E '\\.py$' | xargs -r uv run ruff format --quiet || true"
          }
        ]
      }
    ]
  }
}
