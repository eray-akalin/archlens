<!-- API-level policy for the Azure OpenAI v1 API (docs/AZURE.md §3). Supported on every tier,
     Consumption included. __RATE_LIMIT_CALLS__ is filled in by apim.bicep. -->
<policies>
    <inbound>
        <base />
        <!-- per subscription: the app is one subscription; a runaway loop hits 429 here -->
        <rate-limit calls="__RATE_LIMIT_CALLS__" renewal-period="60" />
        <!-- the subscription key stays at the gateway; Azure OpenAI gets APIM's identity -->
        <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    </inbound>
    <backend>
        <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="2" interval="2" delta="2" first-fast-retry="false">
            <forward-request buffer-request-body="true" timeout="180" />
        </retry>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
