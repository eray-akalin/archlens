{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "1.2.0",
  "$defs": {
    "StageState": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "stage",
        "status",
        "started_at",
        "finished_at",
        "error"
      ],
      "title": "StageState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "repo_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Repo Url"
    },
    "ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ref"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageState"
      },
      "title": "Stages",
      "type": "array"
    },
    "metrics_done": {
      "items": {
        "type": "string"
      },
      "title": "Metrics Done",
      "type": "array"
    },
    "cost_usd": {
      "title": "Cost Usd",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "repo_url",
    "ref",
    "status",
    "stages",
    "metrics_done",
    "cost_usd"
  ],
  "title": "RunState",
  "type": "object"
}
