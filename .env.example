# Copy to .env and fill in. Never commit .env.

# --- LLM provider (OpenAI-compatible) ---------------------------------------
# Azure OpenAI v1 endpoint directly:   https://<resource>.openai.azure.com/openai/v1/
# Through APIM (milestone M4):         https://<apim-name>.azure-api.net/<api-path>/openai/v1/
ARCHLENS_LLM_BASE_URL=
# key | entra   (entra uses DefaultAzureCredential with scope https://ai.azure.com/.default)
ARCHLENS_LLM_AUTH=key
ARCHLENS_LLM_API_KEY=
# Extra header name for APIM subscription keys (leave empty when calling Azure OpenAI directly)
ARCHLENS_LLM_KEY_HEADER=

# Deployment names (not model family names). Defaults assume these deployments exist.
ARCHLENS_MODEL_EVALUATOR=gpt-5-mini
ARCHLENS_MODEL_VERIFIER=gpt-4.1-mini
ARCHLENS_MODEL_SKEPTIC=gpt-5-mini
ARCHLENS_MODEL_SYNTH=gpt-4.1-mini
ARCHLENS_MODEL_EMBED=text-embedding-3-small

# --- Limits & budget --------------------------------------------------------
ARCHLENS_MAX_CONCURRENCY=4
ARCHLENS_TPM_LIMIT=200000
ARCHLENS_RUN_BUDGET_USD=1.00
# off | record | replay   (tests force replay)
ARCHLENS_LLM_RECORD_MODE=off

# --- Storage ----------------------------------------------------------------
# local | azure
ARCHLENS_STORAGE=local
ARCHLENS_DATA_DIR=./.archlens
# Directory holding models.yaml, pricing.yaml, tools.yaml
ARCHLENS_CONFIG_DIR=./config
# Pinned scanner rule packs (default ~/.cache/archlens/tools; /opt/archlens/tools in the image)
ARCHLENS_TOOLS_DIR=
ARCHLENS_AZURE_STORAGE_ACCOUNT=
ARCHLENS_AZURE_COSMOS_ENDPOINT=
ARCHLENS_AZURE_QUEUE_NAME=assessments

# --- Hosted API (M4) --------------------------------------------------------
# Comma-separated API keys accepted in the X-API-Key header (Container Apps secret in the cloud)
ARCHLENS_API_KEYS=
ARCHLENS_ALLOWED_REPO_HOSTS=github.com
ARCHLENS_MAX_CONCURRENT_RUNS_PER_KEY=1
ARCHLENS_RUNS_PER_DAY_PER_KEY=10

# --- Telemetry --------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
ARCHLENS_OTEL_ENABLED=false
